# ==============================================================================
# CompraFácil v2 - Configuración de Variables de Entorno (Plantilla)
# Copiar este archivo como .env y completar con las credenciales reales de Supabase.
# NUNCA subir claves de servicio (service_role) ni secretos al repositorio Git.
# ==============================================================================

# URL de su proyecto Supabase (Ej: https://xyzcompany.supabase.co)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública anónima de Supabase (Anon Key segura para cliente con RLS activo)
SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui
